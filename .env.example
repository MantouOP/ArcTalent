# Optional. Without these, extraction uses explicitly labelled local alias matching.
# Set these as Replit Secrets or in an untracked .env.local file. Never commit keys.
# Use your own deployed RunPod vLLM endpoint and its exact served model identifier.
RUNPOD_BASE_URL=
RUNPOD_API_KEY=
RUNPOD_MODEL=
# Or use a Serverless vLLM endpoint ID and model alias (BASE_URL / MODEL take precedence).
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL_NAME=
# Or any OpenAI-compatible gateway (for example LiteLLM). When complete, these take precedence over RunPod.
# AI_PROVIDER_NAME is the name shown to people before their data is sent; it defaults to AI_MODEL.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER_NAME=
